{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: cl.exe build active file",
      "command": "cmd.exe",
      "args": [
        "/c",
        "cl.exe /Zi /EHsc /nologo /std:c++17 /utf-8 /Fe:main.exe *.cpp"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Компилирует все .cpp файлы текущей папки в main.exe"
    }
  ]
}